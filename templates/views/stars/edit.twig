{% extends "layouts/_base.html.twig" %}
{% block app %}
	<main class="display h-screen m-10">
		<section class="flex justify-center my-10">
			<h3 class="text-4xl font-bold text-white">Edit Star</h3>
		</section>
		<form
			method="POST"
			enctype="multipart/form-data"
			action="/stars/{{ star.id }}"
			class="flex flex-col gap-4 max-w-lg mx-auto"
		>
			<div>
				<label for="name" class="font-bold text-white text-2xl">Name:</label>
				<input
					type="text"
					id="name"
					name="name"
					value="{{ star.name }}"
					class="w-full rounded p-2 text-white bg-white/10 border border-white"
				/>
			</div>

			<div>
				<label for="size" class="font-bold text-white text-2xl">Size (km):</label>
				<input
					type="number"
					id="size"
					name="size"
					value="{{ star.size }}"
					class="w-full rounded p-2 text-white bg-white/10 border border-white"
				/>
			</div>

			<div>
				<label for="description" class="font-bold text-white text-2xl">Description:</label>
				<textarea
					id="description"
					name="description"
					class="w-full rounded p-2 text-white bg-white/10 border border-white"
				>{{ star.description }}</textarea>
			</div>

			<div>
				<label for="image" class="font-bold text-white text-2xl">Image:</label>
				<br />
				<input type="file" id="image" name="image" class="text-white hover:bg-[#2a29696f]" />
			</div>

			<div>
				<label for="planetIds" class="font-bold text-white text-2xl">Planets:</label>
				<select
					id="planetIds"
					name="planetIds"
					multiple
					class="w-full rounded p-2 text-white bg-white/10 border border-white"
				>
					{% for planet in allPlanets %}
						<option value="{{ planet.id }}" {% if planet.id in linkedPlanetIds %}selected{% endif %}>
							{{ planet.name }}
						</option>
					{% endfor %}
				</select>
			</div>

			<div>
				<button
					type="submit"
					class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2"
				>
					Update Star
				</button>
			</div>
		</form>
	</main>
{% endblock %}
