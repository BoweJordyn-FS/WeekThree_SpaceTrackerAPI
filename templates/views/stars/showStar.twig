{% extends "layouts/_base.html.twig" %}
{% block app %}
        <main class="display h-screen m-10">
        <section class="flex justify-center">
            <h3 class="text-3xl text-white">{{star.name}}</h3>
        </section>
        <section class="display flex direction row justify-center">
				<article
					id="starCard"
					class="border border-white rounded-lg p-4 items-center gap-2 w-2xl flex flex-col"
				>
					<div
						id="imageBox"
						class="w-full aspect-3/2 m-2 bg-white/10 rounded-md shrink-0"
					></div>
					<section class="flex flex-col justify-between w-full">
						<p
							id="starType"
							class="text-white text-lg m-4"
						>
							{{star.size}}
						</p>
						<p
							id="starDistance"
							class="text-white text-lg m-4"
						>
							{{star.description}}
						</p>
						<section id="buttons">
							 <a href="/stars/{{star.id}}/edit">edit</a>
                       ``<a href="/stars/{{star.id}}/delete">delete</a>
						</section>
					</section>
				</article>
			</section>
    </main>
{% endblock %}