{% extends "layouts/_base.html.twig" %}
{% block app %}
        <main class="display flex flex-col h-screen m-10">
        <section class="text-white text-lg underline hover:text-[#C2C0C0]"><a href="/stars">← Back</a></section>
        <section class="flex  justify-center my-10">
            <h3 class="text-4xl font-bold text-white">{{star.name}}</h3>
        </section>
        <section class="display flex direction row justify-center">
				<article
					id="starCard"
					class="border border-white rounded-lg p-4 items-center gap-2 w-2xl flex flex-col"
				>
					<div
						id="imageBox"
						class="w-full aspect-3/2 m-2 border border-white/12 bg-white/10 rounded-md shrink-0 overflow-hidden"
					>{% if star.image %}<img src="{{ star.image }}" alt="{{ star.name }}" class="w-full h-full object-cover" />{% endif %}</div>
					<section class="flex flex-col justify-between w-full">
						<div>
							<label class="font-bold text-white text-2xl">Size:</label>
							<p
								id="starType"
								class="text-white text-lg m-4"
							>
								{{star.size}}
							</p>
						</div>
						<div>
							<label class="font-bold text-white text-2xl">Description:</label>
							<p
								id="starDistance"
								class="text-white text-lg m-4"
							>
								{{star.description}}
							</p>
						</div>
						<section id="buttons" class="flex justify-end gap-4 mt-4">
							<a href="/stars/{{star.id}}/edit" class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2">Edit</a>
							<a href="/stars/{{star.id}}/delete" class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2">Delete</a>
						</section>
					</section>
				</article>
			</section>
    </main>
{% endblock %}