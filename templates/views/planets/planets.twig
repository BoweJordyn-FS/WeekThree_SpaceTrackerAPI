{% extends "layouts/_base.html.twig" %}
{% block app %}
    <main class="display h-screen m-10">
                <section class="flex flex-row items-center justify-between mx-2">
                    <h2 class="text-white font-bold text-5xl m-8">Planets</h2>
                    <a href="/planets/new"
                        class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2">
                        + Add Planet
                    </a>
                </section>
                <section
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mx-8 my-6">
                    {% for planet in planets %}
                    <article
                        id="planetCard"
                        class="relative border border-white  rounded-lg p-4 gap-2 w-full max-w-sm mx-auto flex flex-col cursor-pointer">
                        <div
                            id="imageBox"
                            class="w-full aspect-3/2 m-2 border border-white/12 bg-white/10 rounded-md shrink-0  self-center overflow-hidden"
                        >{% if planet.image %}<img src="{{ planet.image }}" alt="{{ planet.name }}" class="w-full h-full object-cover" />{% endif %}</div>
                        <section class="flex w-full mx-1">
                            <h3
                                id="planetName"
                                class="text-white font-bold text-2xl">
                                {{planet.name}}
                            </h3>
                            <a href="/planets/{{planet.id}}/show"
                                id="showInfo"
                                class="font-bold text-white after:absolute after:inset-0">
                                
                            </a>
                        </section>
                       	<section id="buttons" class="relative z-10 flex justify-end gap-4 mt-4">
							<a href="/planets/{{planet.id}}/edit" class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2 cursor-pointer">✎</a>
							<a href="/planets/{{planet.id}}/delete" class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2 cursor-pointer">✖</a>
						</section>
                    </article>
                 {% endfor %}
 
                </section>
            </main>
{% endblock %}