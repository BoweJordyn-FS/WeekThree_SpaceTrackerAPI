{% extends "layouts/_base.html.twig" %}
{% block app %}
    <main class="display h-screen m-10">
                <section class="flex flex-row items-center justify-between mx-2">
                    <h2 class="text-white font-bold text-5xl m-8">Planets</h2>
                    <button
                        class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2">
                        + Add Planet
                    </button>
                </section>
                <section
                    class="grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-8 mx-8 my-6">
                    {% for planet in planets %}
                    <article
                        id="planetCard"
                        class="relative border border-white rounded-lg p-4 items-center gap-2 w-full max-w-sm mx-auto flex flex-col">
                        <div
                            id="imageBox"
                            class="w-full aspect-3/2 m-2 bg-white/10 rounded-md shrink-0"
                        ></div>
                        <section class="flex items-center justify-between w-full mx-4">
                            <h3
                                id="planetName"
                                class="text-white font-bold text-xl">
                                {{planet.name}}
                            </h3>
                            <a href="/planets/{{planet.id}}/show"
                                id="showInfo"
                                class="font-bold text-white after:absolute after:inset-0">
                                
                            </a>
                        </section>
                        <section
                            id="planetDetails"
                            class="hidden text-center">
                            <p
                                id="planetSize"
                                class="text-white text-lg m-4">
                                {{planet.size}}
                            </p>
                            <p
                                id="planetDistance"
                                class="text-white text-lg m-4">
                                {{planet.description}}
                            </p>
                       <a href="/planets/{{planet.id}}/edit" class="relative z-10">edit</a>
                       <a href="/planets/{{planet.id}}/delete" class="relative z-10">delete</a>
                        </section>

                    </article>
                 {% endfor %}
 
                </section>
            </main>
{% endblock %}