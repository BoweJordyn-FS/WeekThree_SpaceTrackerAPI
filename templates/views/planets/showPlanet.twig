{% extends "layouts/_base.html.twig" %}
{% block app %}
        <main class="display min-h-screen m-10">
        <section class="text-white text-lg underline hover:text-[#C2C0C0]"><a href="/planets">← Back</a></section>
        <section class="flex justify-center my-10">
            <h3 class="text-4xl font-bold text-white">{{planet.name}}</h3>
        </section>
        <section class="display flex direction row justify-center">
				<article
					id="planetCard"
					class="border border-white rounded-lg p-4 items-center gap-2 w-2xl flex flex-col"
				>
					<div
						id="imageBox"
						class="w-full aspect-3/2 m-2 border border-white/12 bg-white/10 rounded-md shrink-0 overflow-hidden"
					>{% if planet.image %}<img src="{{ planet.image }}" alt="{{ planet.name }}" class="w-full h-full object-cover" />{% endif %}</div>
					<section class="flex flex-col justify-between w-full">
						<div>
							<label class="font-bold text-white text-2xl">Size (km):</label>
							<p
								id="planetType"
								class="text-white text-lg m-4"
							>
								{{planet.size}}
							</p>
						</div>
						<div>
							<label class="font-bold text-white text-2xl">Description:</label>
							<p
								id="planetDistance"
								class="text-white text-lg m-2"
							>
								{{planet.description}}
							</p>
						</div>
			{% if stars|length > 0 %}
			<section class="mt-4">
				<h4 class="text-white font-bold text-2xl mb-4">Stars</h4>
				<section class="grid grid-rows gap-6 mb-6">
					{% for star in stars %}
						<a href="/stars/{{ star.id }}"
							class="block border border-white rounded-lg p-4 text-white hover:bg-white/10">
							{{ star.name }}
						</a>
					{% endfor %}
				</section>
			</section>
			{% endif %}
						<section id="buttons" class="flex justify-end gap-4 mt-4">
							<a href="/planets/{{planet.id}}/edit" class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2">Edit</a>
							<a href="/planets/{{planet.id}}/delete" class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2">Delete</a>
						</section>
					</section>
				</article>
			</section>

    </main>
{% endblock %}