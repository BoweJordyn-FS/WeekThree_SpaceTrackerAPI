{% extends "layouts/_base.html.twig" %}
{% block app %}
<main class="display text-center content-center h-screen">
			<section class="mb-40">
				<h1 class="text-white font-bold text-5xl m-8">Star Tracker API</h1>
				<h4 class="text-white text-2xl m-8">
					Welcome to the Star Tracker API! This is a simple API for tracking
					stars in the universe. <br />Click a button to get started.
				</h4>
				<section
					class="display flex justify-center align-items center gap-5 m-8"
				>
					<button
						id="goStars"
						class="bg-blue-500 hover:bg-blue-700 text-white text-lg font-bold py-4 px-8 rounded"
					>
						<a href="/stars">Stars</a>
					</button>
					<button
						id="goPlanets"
						class="bg-blue-500 hover:bg-blue-700 text-white text-lg font-bold py-4 px-8 rounded"
					>
						<a href="/planets">Planets</a>
					</button>
					<button
						id="goGalaxies"
						class="bg-blue-500 hover:bg-blue-700 text-white text-lg font-bold py-4 px-8 rounded"
					>
						<a href="/galaxies">Galaxies</a>
					</button>
				</section>
			</section>
		</main>
{% endblock %}