<form
	method="POST"
	enctype="multipart/form-data"
	action="{{ action }}"
	class="flex flex-col gap-4 max-w-lg mx-auto"
>
	{% if method == 'PUT' %}
		<input type="hidden" name="_method" value="PUT">
	{% endif %}

	{% if error %}
		<p class="text-red-400 font-bold">{{ error }}</p>
	{% endif %}

	<div>
		<label for="name" class="font-bold text-white text-2xl">Name:</label>
		<input
			type="text"
			id="name"
			name="name"
			value="{{ item.name }}"
			class="w-full rounded p-2 text-white bg-white/10 border border-white"
		/>
	</div>

	<div>
		<label for="size" class="font-bold text-white text-2xl">Size:</label>
		<input
			type="number"
			id="size"
			name="size"
			value="{{ item.size }}"
			class="w-full rounded p-2 text-white bg-white/10 border border-white"
		/>
	</div>

	<div>
		<label for="description" class="font-bold text-white text-2xl">Description:</label>
		<textarea
			id="description"
			name="description"
			class="w-full rounded p-2 text-white bg-white/10 border border-white"
		>{{ item.description }}</textarea>
	</div>

	<div>
		<label for="image" class="font-bold text-white text-2xl">Image:</label>
		<br />
		<input type="file" id="image" name="image" class="text-white hover:bg-[#2a29696f]" />
	</div>

	<div>
		<button
			type="submit"
			class="bg-white hover:bg-[#CAC4ED] text-[#422E8F] font-bold rounded px-4 py-2"
		>
			{{ submitLabel|default('Save') }}
		</button>
	</div>
</form>
